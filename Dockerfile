# syntax=docker/dockerfile:1.7

# veritas
#
# Generated by gen_containers.py; keep in step with packaging/.

FROM opensuse/tumbleweed:latest AS builder

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

WORKDIR /src

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends guile; \
    zypper clean --all

COPY src/veritas ./src/veritas
COPY bin/veritas ./bin/veritas
COPY man/veritas.1 ./man/veritas.1

RUN set -eu; \
    site="/usr/share/guile/site/3.0"; \
    install -d "$site/veritas"; \
    cp -r "src/veritas/." "$site/veritas/"; \
    install -D -m 0755 "bin/veritas" "/usr/bin/veritas"; \
    sed -i '1s|^#!/usr/bin/env \(.*\)$|#!/usr/bin/\1|' "/usr/bin/veritas"; \
    sed -i 's|"$here/../src"|"/usr/share/guile/site/3.0"|' "/usr/bin/veritas"; \
    install -D -m 0644 "man/veritas.1" "/usr/share/man/man1/veritas.1"

# ----------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------

FROM opensuse/tumbleweed:latest AS runtime

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

LABEL org.opencontainers.image.title="veritas" \
      org.opencontainers.image.description="Testing framework for Guile Scheme" \
      org.opencontainers.image.url="https://github.com/jjba23/veritas" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}"

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends \
        guile \
        ca-certificates \
        guile-json \
        guile-fibers \
        bash \
        coreutils; \
    zypper clean --all

COPY --from=builder /usr/share/guile/site/3.0/veritas /usr/share/guile/site/3.0/veritas
COPY --from=builder /usr/bin/veritas /usr/bin/veritas
COPY --from=builder /usr/share/man/man1/veritas.1 /usr/share/man/man1/veritas.1

ENTRYPOINT ["/usr/bin/veritas"]
