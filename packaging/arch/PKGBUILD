# Maintainer: Josep Bigorra <jjbigorra@gmail.com>
pkgname=veritas
pkgver=1.3.1
pkgrel=1
pkgdesc="Testing framework for Guile Scheme"
arch=('any')
url="https://github.com/jjba23/veritas"
license=('MIT')

depends=(
  'guile'
  'bash'
  'coreutils'
  'guile-json'
  'guile-fibers'
)

makedepends=(
  'guile'
  'pkgconf'
)

source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('d6832dbdb01a4c51609dcecddff633494bb36ee61421b060d3a7976b1e68ba3d')

# Guile looks for byte-compiled modules under the site-ccache directory,
# which differs between distributions, so ask Guile's pkg-config file
# instead of hard-coding a path.
_site_dir() {
  pkg-config --variable=sitedir guile-3.0 2>/dev/null \
    || echo /usr/share/guile/site/3.0
}

_compiled_dir() {
  pkg-config --variable=siteccachedir guile-3.0 2>/dev/null \
    || echo /usr/lib/guile/3.0/site-ccache
}

build() {
  cd "$srcdir/veritas"

  # Byte-compile every module, mirroring the source tree under a staging
  # directory that package() copies into the compiled site directory.
  rm -rf "$srcdir/ccache"
  mkdir -p "$srcdir/ccache/veritas"

  while IFS= read -r scm_file; do
    rel_path="${scm_file#src/}"
    go_file="$srcdir/ccache/${rel_path%.scm}.go"
    mkdir -p "$(dirname "$go_file")"
    guild compile -L src -o "$go_file" "$scm_file"
  done < <(find src/veritas -name '*.scm')
}

check() {
  cd "$srcdir/veritas"

  VERITAS_TEST_TYPE=unit guile -L ./src -L ./test -c '((@ (veritas runner) run-tests))'
}

package() {
  cd "$srcdir/veritas"

  # The launcher resolves its modules and resources relative to its
  # own prefix, so the installed layout below is what it expects.
  install -Dm755 bin/veritas "$pkgdir/usr/bin/veritas"
  sed -i 's|"$here/../src"|"/usr/share/guile/site/3.0"|' "$pkgdir/usr/bin/veritas"

  site_dir="$(_site_dir)"
  install -d "$pkgdir${site_dir}/veritas"
  cp -r src/veritas/. "$pkgdir${site_dir}/veritas/"

  ccache_dir="$(_compiled_dir)"
  install -d "$pkgdir${ccache_dir}/veritas"
  cp -r "$srcdir/ccache/veritas/." "$pkgdir${ccache_dir}/veritas/"
  install -Dm644 man/veritas.1 "$pkgdir/usr/share/man/man1/veritas.1"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.org "$pkgdir/usr/share/doc/$pkgname/README.org"
  install -Dm644 NEWS.org "$pkgdir/usr/share/doc/$pkgname/NEWS.org"
}
